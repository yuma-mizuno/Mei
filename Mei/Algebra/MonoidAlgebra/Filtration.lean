module

public import Mei.Algebra.MonoidAlgebra.Derivation
public import Mei.Algebra.MonoidAlgebra.Character
public import Mei.RingTheory.FilteredAlgebra.Basic
public import Mathlib.Algebra.MonoidAlgebra.Ideal
import Mathlib.Algebra.MonoidAlgebra.Support

/-!
# Monomial filtrations on coefficient algebras

For a submonoid `P` of a coefficient monoid `M` and an integral degree `δ`,
filter `R[M]` by the ideals generated by `z^n` for `n ∈ P` and `δ(n) ≥ k`.
Their elements are precisely the sums supported on exponents `q + n` with
`q ∈ M`, `n ∈ P` and `δ(n) ≥ k`. Multiplication adds filtration orders,
and a nonnegative lower bound on `δ(n)` gives an order-raising bound
for logarithmic derivations of degree `n ∈ P`.

For a positive monoid in a larger degree group and a coefficient monoid `Q`
containing it, use its inverse image under `Q.subtype` and restrict the degree
to `Q`. This retains the positive increments rather than filtering by the
ambient degree of a coefficient, which can be negative. When every exponent
is allowed (`P = ⊤`) and `δ` is nonnegative,
`mem_monoidAlgebraIdeal_top_iff_of_nonneg` identifies these ideals with ordinary
degree cutoffs. Applied to the monoid of positive exponents itself, this compares
the coefficient filtration with the degree truncations used for its completion.

The support characterization uses `AddMonoidAlgebra.mem_ideal_span_of'_image`;
the action calculation uses `Mei.AddMonoidAlgebra.monomialDerivation_single`.
The coefficient filtration and logarithmic action follow Mandel,
*Scattering diagrams, theta functions, and refined tropical curve counts*,
Example 2.1(i). No finite generation, saturation or characteristic-zero
hypothesis is required.
-/

public section

noncomputable section

open AddMonoidAlgebra

namespace AddSubmonoid

variable {M R : Type*} [AddCommMonoid M] [Semiring R]
  (P : AddSubmonoid M) (δ : M →+ ℤ)

/-- The ideal generated by the allowed-increment monomials of order at least `k`. -/
def monoidAlgebraIdeal (k : ℕ) : Ideal R[M] :=
  Ideal.span (of' R M '' {n | n ∈ P ∧ (k : ℤ) ≤ δ n})

/-- The monomial ideal is the span of its allowed-increment generators. -/
theorem monoidAlgebraIdeal_def (k : ℕ) :
    P.monoidAlgebraIdeal (R := R) δ k =
      Ideal.span (of' R M '' {n | n ∈ P ∧ (k : ℤ) ≤ δ n}) := (rfl)

/-- Containment in an ideal is equivalent to membership of every allowed generator. -/
theorem monoidAlgebraIdeal_le_iff (k : ℕ) (I : Ideal R[M]) :
    P.monoidAlgebraIdeal δ k ≤ I ↔
      ∀ n ∈ P, (k : ℤ) ≤ δ n → of' R M n ∈ I := by
  rw [monoidAlgebraIdeal_def, Ideal.span_le, Set.image_subset_iff]
  simp only [Set.subset_def, Set.mem_ofPred_eq, Set.mem_preimage, SetLike.mem_coe, and_imp]

/-- Membership is measured by allowed increments in each supported exponent,
not by the total degree of that exponent. -/
theorem mem_monoidAlgebraIdeal_iff (k : ℕ) (f : R[M]) :
    f ∈ P.monoidAlgebraIdeal δ k ↔
      ∀ p ∈ f.coeff.support, ∃ n ∈ P, (k : ℤ) ≤ δ n ∧ ∃ q, p = q + n := by
  simp only [monoidAlgebraIdeal, mem_ideal_span_of'_image, Set.mem_ofPred_eq, and_assoc]

/-- When all exponents are allowed and their degrees are nonnegative, monomial
ideal membership is exactly the degree bound on every supported exponent. -/
theorem mem_monoidAlgebraIdeal_top_iff_of_nonneg {δ : M →+ ℤ}
    (hδ : ∀ n, 0 ≤ δ n) (k : ℕ) (f : R[M]) :
    f ∈ (⊤ : AddSubmonoid M).monoidAlgebraIdeal δ k ↔
      ∀ p ∈ f.coeff.support, (k : ℤ) ≤ δ p := by
  rw [mem_monoidAlgebraIdeal_iff]
  constructor
  · intro hf p hp
    obtain ⟨n, _, hn, q, rfl⟩ := hf p hp
    simpa only [map_add] using hn.trans (le_add_of_nonneg_left (hδ q))
  · intro hf p hp
    exact ⟨p, mem_top p, hf p hp, 0, by simp⟩

/-- A monomial belongs precisely when its coefficient vanishes or its exponent
contains an increment of the required order. -/
@[simp]
theorem single_mem_monoidAlgebraIdeal_iff (k : ℕ) (p : M) (r : R) :
    single p r ∈ P.monoidAlgebraIdeal δ k ↔
      r = 0 ∨ ∃ n ∈ P, (k : ℤ) ≤ δ n ∧ ∃ q, p = q + n := by
  classical
  rw [mem_monoidAlgebraIdeal_iff]
  by_cases hr : r = 0 <;> simp [hr]

/-- Increasing the required increment order decreases the monomial ideal. -/
theorem monoidAlgebraIdeal_antitone : Antitone (P.monoidAlgebraIdeal (R := R) δ) := by
  intro k l h f hf
  rw [mem_monoidAlgebraIdeal_iff] at hf ⊢
  intro p hp
  obtain ⟨n, hn, hd, q, he⟩ := hf p hp
  exact ⟨n, hn, (Int.ofNat_le.mpr h).trans hd, q, he⟩

/-- Every coefficient has increment order at least zero. -/
@[simp]
theorem monoidAlgebraIdeal_zero : P.monoidAlgebraIdeal (R := R) δ 0 = ⊤ := by
  apply top_unique
  intro f _
  rw [mem_monoidAlgebraIdeal_iff]
  exact fun p _ => ⟨0, P.zero_mem, by simp, p, by simp⟩

/-- Multiplication adds the orders of the allowed increments. -/
theorem mul_mem_monoidAlgebraIdeal {a b : ℕ} {f g : R[M]}
    (hf : f ∈ P.monoidAlgebraIdeal δ a) (hg : g ∈ P.monoidAlgebraIdeal δ b) :
    f * g ∈ P.monoidAlgebraIdeal δ (a + b) := by
  classical
  rw [mem_monoidAlgebraIdeal_iff] at hf hg ⊢
  intro p hp
  obtain ⟨q, hq, r, hr, rfl⟩ := Finset.mem_add.mp (support_coeff_mul_subset f g hp)
  obtain ⟨n, hn, hd, q', rfl⟩ := hf q hq
  obtain ⟨m, hm, he, r', rfl⟩ := hg r hr
  refine ⟨n + m, P.add_mem hn hm, ?_, q' + r', by ac_rfl⟩
  simpa only [map_add, Nat.cast_add] using add_le_add hd he

/-- Monomial ideals are two-sided even when the coefficients do not commute. -/
instance monoidAlgebraIdeal_isTwoSided (k : ℕ) :
    (P.monoidAlgebraIdeal (R := R) δ k).IsTwoSided where
  mul_mem_of_left g hf := by
    have hg : g ∈ P.monoidAlgebraIdeal δ 0 := by simp
    simpa only [Nat.add_zero] using P.mul_mem_monoidAlgebraIdeal δ hf hg

/-- The decreasing multiplicative filtration generated by monomials in `P`,
with orders measured by `δ`. -/
def monoidAlgebraFiltration : Mei.AlgFiltration R[M] where
  ideal := P.monoidAlgebraIdeal δ
  isTwoSided _ := inferInstance
  antitone := P.monoidAlgebraIdeal_antitone δ
  ideal_zero := P.monoidAlgebraIdeal_zero δ
  mul_mem := P.mul_mem_monoidAlgebraIdeal δ

/-- The filtration terms are the monomial ideals. -/
@[simp]
theorem monoidAlgebraFiltration_ideal (k : ℕ) :
    (P.monoidAlgebraFiltration (R := R) δ).ideal k = P.monoidAlgebraIdeal δ k := (rfl)

/-- A logarithmic derivation with degree in `P` raises the monomial filtration
by any nonnegative lower bound on that degree. -/
theorem monomialDerivation_mem_monoidAlgebraIdeal {R : Type*} [CommSemiring R]
    {n : M} (hn : n ∈ P)
    (m : M →+ R) {a b : ℕ} (ha : (a : ℤ) ≤ δ n)
    {f : R[M]} (hf : f ∈ P.monoidAlgebraIdeal δ b) :
    Mei.AddMonoidAlgebra.monomialDerivation n m f ∈ P.monoidAlgebraIdeal δ (a + b) := by
  classical
  rw [← f.sum_coeff_single, map_finsuppSum]
  apply (P.monoidAlgebraIdeal δ (a + b)).sum_mem
  intro p hp
  obtain ⟨r, hr, hd, q, rfl⟩ := (P.mem_monoidAlgebraIdeal_iff δ b f).mp hf p hp
  simp only [Mei.AddMonoidAlgebra.monomialDerivation_single, single_mem_monoidAlgebraIdeal_iff]
  refine Or.inr ⟨n + r, P.add_mem hn hr, ?_, q, by ac_rfl⟩
  simpa only [map_add, Nat.cast_add] using add_le_add ha hd

/-- A monoid map carrying allowed increments into allowed increments maps a
source ideal into a target ideal whenever the corresponding cutoff bound holds.
This is the filtration bound needed to extend the induced algebra map to completions. -/
theorem monoidAlgebraIdeal_le_comap_mapDomainRingHom {N : Type*} [AddCommMonoid N]
    (Q : AddSubmonoid N) (ε : N →+ ℤ) (T : M →+ N)
    (hT : ∀ n ∈ P, T n ∈ Q) {a b : ℕ}
    (hδ : ∀ n ∈ P, (a : ℤ) ≤ δ n → (b : ℤ) ≤ ε (T n)) :
    P.monoidAlgebraIdeal (R := R) δ a ≤
      (Q.monoidAlgebraIdeal ε b).comap (mapDomainRingHom R T) := by
  rw [monoidAlgebraIdeal_le_iff]
  intro n hn hd
  simp only [Ideal.mem_comap, of'_apply, mapDomainRingHom_apply, mapDomain_single,
    single_mem_monoidAlgebraIdeal_iff]
  exact Or.inr ⟨T n, hT n hn, hδ n hn hd, 0, by simp⟩

/-- Character-weighted exponent transport respects monomial cutoffs with the
same bound as ordinary exponent transport, even when character values vanish. -/
theorem monoidAlgebraIdeal_le_comap_characterMap {R N : Type*}
    [CommSemiring R] [AddCommMonoid N]
    (Q : AddSubmonoid N) (ε : N →+ ℤ) (T : M →+ N)
    (χ : Multiplicative M →* R) (hT : ∀ n ∈ P, T n ∈ Q) {a b : ℕ}
    (hδ : ∀ n ∈ P, (a : ℤ) ≤ δ n → (b : ℤ) ≤ ε (T n)) :
    P.monoidAlgebraIdeal δ a ≤
      (Q.monoidAlgebraIdeal ε b).comap (characterMap R T χ) := by
  rw [monoidAlgebraIdeal_le_iff]
  intro n hn hd
  simp only [Ideal.mem_comap, of'_apply, characterMap_single, one_mul,
    single_mem_monoidAlgebraIdeal_iff]
  exact Or.inr ⟨T n, hT n hn, hδ n hn hd, 0, by simp⟩

/-- Changing scalar coefficients preserves every monomial filtration term,
including when the coefficient homomorphism kills some terms. -/
theorem monoidAlgebraIdeal_le_comap_mapRingHom {S : Type*} [Semiring S]
    (φ : R →+* S) (k : ℕ) :
    P.monoidAlgebraIdeal (R := R) δ k ≤
      (P.monoidAlgebraIdeal (R := S) δ k).comap (mapRingHom M φ) := by
  rw [monoidAlgebraIdeal_le_iff]
  intro n hn hd
  simp only [Ideal.mem_comap, of'_apply, mapRingHom_single, map_one,
    single_mem_monoidAlgebraIdeal_iff]
  exact Or.inr ⟨n, hn, hd, 0, by simp⟩

end AddSubmonoid
